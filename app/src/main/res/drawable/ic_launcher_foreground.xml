    <!-- 3D Violet Orb Main Body -->
    <path android:pathData="M54,54m-26,0a26,26 0 1,0 52,0a26,26 0 1,0 -52,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="32"
                android:startY="30"
                android:endX="76"
                android:endY="78"
                android:startColor="#A78BFA"
                android:endColor="#6D28D9" />
