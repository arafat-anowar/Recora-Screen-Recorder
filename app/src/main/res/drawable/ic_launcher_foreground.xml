    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,54m-16,0a16,16 0 1,0 32,0a16,16 0 1,0 -32,0" />

    <!-- Ruby Core Recording Lens (3D gradient) -->
    <path android:pathData="M54,54m-12,0a12,12 0 1,0 24,0a12,12 0 1,0 -24,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="44"
                android:startY="44"
                android:endX="64"
                android:endY="64"
                android:startColor="#F87171"
                android:endColor="#DC2626" />
        </aapt:attr>
    </path>

    <!-- Center Light Reflection / Lens Flare -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.9"
        android:pathData="M54,54m-3.5,0a3.5,3.5 0 1,0 7,0a3.5,3.5 0 1,0 -7,0" />
